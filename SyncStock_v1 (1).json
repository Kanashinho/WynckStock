    {
      "parameters": {
        "jsCode": "// AJUSTE A LINHA ABAIXO COM O CAMINHO CORRETO DO SEU WEBHOOK OUTPUT\nconst mensagemCompleta = $('Webhook').first().json.body.text.message; // Ou o caminho correto que você encontrou\n\nconst mensagem = mensagemCompleta.toUpperCase().trim();\n\nlet resultado = {\n  comandoOriginal: mensagemCompleta,\n  comandoAnalisado: null,\n  nomeItem: null,\n  quantidade: null, // Para o comando RETIRAR depois\n  erro: null\n};\n\nconst partes = mensagem.split(' ');\nconst primeiroComando = partes[0];\n\nif (primeiroComando === \"ESTOQUE\") {\n  if (partes.length > 1) {\n    resultado.comandoAnalisado = \"ESTOQUE_ITEM\";\n    resultado.nomeItem = partes.slice(1).join(' ').trim();\n  } else {\n    resultado.comandoAnalisado = \"ESTOQUE_GERAL\";\n  }\n} else if (primeiroComando === \"RETIRAR\") {\n  resultado.comandoAnalisado = \"RETIRAR\"; // Placeholder\n  // Adicionar lógica para extrair quantidade e nomeItem para RETIRAR\n  if (partes.length > 2 && !isNaN(partes[1])) { // Verifica se tem pelo menos 3 partes e a segunda é um número\n    resultado.quantidade = parseInt(partes[1]);\n    resultado.nomeItem = partes.slice(2).join(' ').trim();\n  } else {\n    resultado.erro = \"Formato RETIRAR inválido (Ex: RETIRAR 2 ProdutoX)\";\n  }\n} else if (primeiroComando === \"AJUDA\") {\n  resultado.comandoAnalisado = \"AJUDA\";\n} else {\n  resultado.erro = \"Comando desconhecido\";\n  resultado.comandoAnalisado = \"ERRO\"; // Para o nó IF\n}\n\nreturn [resultado]; // Retorna como um array de itens para o n8n"
      },
