    {
      "parameters": {
        "jsCode": "// Este nó recebe uma LISTA de itens do nó Airtable anterior\n// que passaram pelo filtro do IF (ou seja, são itens reais com ID)\n\nconst itensDeEntrada = items; \nlet listaItensTexto = \"\";\n\nif (itensDeEntrada && itensDeEntrada.length > 0) {\n    for (const itemEntrada of itensDeEntrada) {\n        // Ajuste o caminho abaixo se a estrutura da sua entrada for diferente.\n        // Verifique a saída do nó que ALIMENTA este nó \"Formatar Msg Estoque Baixo\".\n        const fields = itemEntrada.json.fields || itemEntrada.json; \n\n        if (fields) {\n            const nome = fields.item_name;\n            const atual = fields.estoque_atual;\n            const minimo = fields.limite_baixo_estoque;\n            const unidade = fields.unidade || 'un'; // Usa 'un' como padrão se unidade estiver vazia\n\n            if (nome !== undefined && atual !== undefined && minimo !== undefined) {\n                 // LINHA CRÍTICA - Garanta que está exatamente assim:\n                 listaItensTexto += `- ${nome}: ${atual} ${unidade} (Mín:${minimo})\\n`;\n            } else {\n                // console.log(\"Item com campos essenciais em falta:\", fields);\n            }\n        } else {\n            // console.log(\"Item de entrada sem o objeto 'fields' esperado:\", itemEntrada.json);\n        }\n    }\n}\n\n// ***** IMPORTANTE: Substitua pelo link real e compartilhável da sua tabela Inventory no Airtable *****\nconst linkPlanilhaAirtable = \"https://SEU_LINK_COMPARTILHAVEL_AIRTABLE_AQUI\"; \n\nlet mensagemFinal = \"\";\n\nif (listaItensTexto) { // Se a lista de itens baixos (listaItensTexto) não estiver vazia\n    mensagemFinal = `⚠️ Estoque Baixo:\\n${listaItensTexto}\\nPara detalhes: ESTOQUE <Nome Item>\\nLista completa: ${linkPlanilhaAirtable}`;\n} else {\n    // Este caminho só seria atingido se o nó IF anterior permitisse que este nó executasse sem itens.\n    // Com a lógica correta do IF, este 'else' não é estritamente necessário aqui.\n    mensagemFinal = `✅ Nenhum item encontrado com estoque baixo.\\n\\nPara detalhes: ESTOQUE <Nome Item>\\nLista completa: ${linkPlanilhaAirtable}`;\n}\n\nreturn [{ json: { mensagemResposta: mensagemFinal } }];"
      },
